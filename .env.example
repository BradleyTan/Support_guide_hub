# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project settings > API. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser tests (optional, a dedicated TEST account, never your real one):
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_ALLOW_WRITES=1   # lets e2e/guides.spec.ts create and delete [e2e] guides

# Only if AI is turned on later (server-only, never prefixed with NEXT_PUBLIC_):
# ANTHROPIC_API_KEY=
